# Copy to .env and fill in real values there. Never commit .env.
# Path to the Google service-account JSON key (keep it under secrets/, which is gitignored).
GOOGLE_APPLICATION_CREDENTIALS=secrets/your-service-account-key.json
# Required. Passcode that unlocks /teacher. Never commit the real value.
TEACHER_PASSCODE=
# SQLite database file.
QUIZBUZZER_DB_PATH=data/quizbuzzer.db
# Bind address and port (use the LAN IP or 0.0.0.0 for the classroom).
QUIZBUZZER_HOST=127.0.0.1
QUIZBUZZER_PORT=8000
