@startuml 001-seq-confirm-create
title 001 Sheets Import - Confirm preview and create DRAFT activity

skinparam shadowing false
skinparam defaultFontName "Microsoft JhengHei"
autonumber

actor Teacher
participant "Teacher UI\n(teacher.js)" as TUI
participant "API server\n(teacher_routes)" as API
participant "ActivityService" as ACT
participant "SheetsAdapter" as SA
participant "guided_notes_parser" as PARSER
database "SQLite store\n(db.py)" as DB
participant "RealtimeHub" as RT

Teacher -> TUI : choose group count (2-12),\nacknowledge warnings, confirm
TUI -> API : POST /api/teacher/activities\n{url, sheetId, groupCount,\nfingerprint, acknowledgeWarnings}
API -> ACT : create_from_import(...)
alt groupCount outside 2-12
  ACT --> API : raise InvalidGroupCount
  API --> TUI : 422 invalid_group_count
else valid
  ACT -> SA : read_tab(spreadsheet_id, sheet_id)
  SA --> ACT : TabData(grid, merges)
  ACT -> PARSER : parse(grid, merges)
  PARSER --> ACT : ImportPreview
  ACT -> ACT : add identity, compute_fingerprint(...)
  alt preview has errors
    ACT --> API : raise ImportHasErrors(preview)
    API --> TUI : 422 import_errors (confirmation blocked)
  else fingerprint differs from confirmed one
    ACT --> API : raise PreviewChanged(preview)
    API --> TUI : 409 preview_changed + updated preview
  else warnings present and not acknowledged
    ACT --> API : raise WarningsNotAcknowledged
    API --> TUI : 422 warnings_not_acknowledged
  else ok
    ACT -> DB : BEGIN IMMEDIATE
    ACT -> DB : any activity with phase DRAFT or OPEN?
    alt a current (non-CLOSED) activity exists
      ACT -> DB : ROLLBACK
      ACT --> API : raise CurrentActivityExists(activity, phase)
      API --> TUI : 409 current_activity_exists;\nsuggest re-import or cancel (DRAFT, 002)\nor end (OPEN)
    else none
      ACT -> DB : insert activities (phase = DRAFT, group_count, source)
      ACT -> DB : insert question_units + answer_slots\n(answer cell locations)
      ACT -> DB : COMMIT
      DB --> ACT : ok
      ACT -> RT : publish activity.state
      RT -->> TUI : activity.state (all teacher sockets)
      ACT --> API : Activity
      API --> TUI : 201 activity (DRAFT)
      TUI --> Teacher : show DRAFT activity
    end
  end
end

note right of DB
  All-or-nothing (FR-023):
  any failure rolls back.
  "At most one non-CLOSED activity"
  is checked inside the same
  transaction and backed by a partial
  unique index (FR-020a). CLOSED
  activities are never touched.
end note

note over TUI, API
  Teacher-only: feature 002's teacher
  passcode check applies.
end note
@enduml
