@startuml 001-seq-reimport
title 001 Sheets Import - Re-import into a DRAFT activity

skinparam shadowing false
skinparam defaultFontName "Microsoft JhengHei"
autonumber

actor Teacher
participant "Teacher UI\n(teacher.js)" as TUI
participant "API server\n(teacher_routes)" as API
participant "ActivityService" as ACT
participant "SheetsAdapter" as SA
participant "guided_notes_parser" as PARSER
database "SQLite store\n(db.py)" as DB
participant "RealtimeHub" as RT

Teacher -> TUI : re-import (url, tab)
TUI -> API : POST /api/teacher/activities/{id}/reimport/preview\n{url, sheetId}
API -> ACT : preview_reimport(activity_id, url, sheet_id)
ACT -> ACT : check_reimport_allowed(activity_id)
ACT -> DB : read activity phase
alt activity does not exist
  ACT --> API : raise ActivityNotFound
  API --> TUI : 404 not_found
else phase is OPEN or CLOSED
  ACT --> API : raise ReimportRefused(phase)
  API --> TUI : 409 reimport_refused\n"activity is <phase>"
else phase is DRAFT
  ACT -> SA : read_tab(spreadsheet_id, sheet_id)
  SA --> ACT : TabData(grid, merges)
  ACT -> PARSER : parse(grid, merges)
  PARSER --> ACT : ImportPreview
  ACT -> ACT : add identity, compute_fingerprint(...)
  ACT --> API : ImportPreview
  API --> TUI : 200 preview (errors / warnings)
  Teacher -> TUI : confirm replacement
  TUI -> API : PUT /api/teacher/activities/{id}/questions\n{url, sheetId, fingerprint, acknowledgeWarnings}
  API -> ACT : replace_questions(...)
  ACT -> SA : read_tab(spreadsheet_id, sheet_id)
  SA --> ACT : TabData(grid, merges)
  ACT -> PARSER : parse(grid, merges)
  PARSER --> ACT : ImportPreview
  ACT -> ACT : add identity, compute_fingerprint(...)
  alt errors / fingerprint differs / warnings not acknowledged
    ACT --> API : raise ImportHasErrors /\nPreviewChanged / WarningsNotAcknowledged
    API --> TUI : 422 / 409 / 422
  else ok
    ACT -> DB : BEGIN IMMEDIATE
    ACT -> DB : re-check phase = DRAFT
    alt activity no longer exists
      ACT -> DB : ROLLBACK
      ACT --> API : raise ActivityNotFound
      API --> TUI : 404 not_found
    else phase changed to OPEN or CLOSED
      ACT -> DB : ROLLBACK
      ACT --> API : raise ReimportRefused(phase)
      API --> TUI : 409 reimport_refused, questions unchanged
    else still DRAFT
      ACT -> DB : delete old question_units\n(answer_slots cascade)
      ACT -> DB : insert new question_units + answer_slots
      ACT -> DB : update source spreadsheet / tab, imported_at
      ACT -> DB : COMMIT
      ACT -> RT : publish activity.state
      RT -->> TUI : activity.state (all teacher sockets)
      ACT --> API : Activity
      API --> TUI : 200 updated DRAFT activity\n(phase + groupCount unchanged)
    end
  end
end

note right of DB
  Phase is re-checked inside the same
  transaction as the replacement (FR-026).
end note

note over TUI, API
  Teacher-only: feature 002's teacher
  passcode check applies.
end note
@enduml
