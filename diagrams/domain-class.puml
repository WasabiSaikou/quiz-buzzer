@startuml domain-class
title Quiz Buzzer (課堂搶答系統) - Domain Classes (models.py)

skinparam shadowing false
skinparam defaultFontName "Microsoft JhengHei"
hide empty methods

enum Phase {
  DRAFT
  OPEN
  CLOSED
}

enum UnitKind {
  SINGLE
  GROUP_SET
}

class Activity {
  id : int
  title : str
  phase : Phase
  groupCount : int {2..12}
  sourceSpreadsheetId : str
  sourceSheetId : int
  sourceTabTitle : str
  createdAt : str {ISO-8601 UTC}
  importedAt : str {ISO-8601 UTC}
}

class QuestionUnit {
  id : int
  number : int {>0}
  kind : UnitKind
  sourceRow : int
  position : int
}

class AnswerSlot {
  id : int
  subPart : int {>0}
  cellRow : int
  cellColumn : int
  a1Ref : str
}

class Group {
  id : int
  number : int {1..groupCount}
  name : str
}

class Participant {
  id : int
  displayName : str
  joinedAt : datetime
}

class Submission {
  id : int
  arrivalSeq : int
  receivedAt : datetime
  answers : Map<AnswerSlot, str>
  isWinner : bool
}

Activity "1" *-- "1..*" QuestionUnit : questions >
QuestionUnit "1" *-- "1..*" AnswerSlot : slots >
Activity "1" *-- "2..12" Group : groups >
Group "1" *-- "0..*" Participant : members >
QuestionUnit "1" o-- "0..*" Submission : submissions >
Group "1" -- "0..*" Submission : submits >
Activity --> Phase
QuestionUnit --> UnitKind

note right of Activity
  At most one Activity is non-CLOSED
  (DRAFT or OPEN) at a time.
  CLOSED activities are kept, with
  results / CSV viewable.
  Slots live on the activity's source
  tab (sourceSheetId / sourceTabTitle).
end note

note right of AnswerSlot
  Cell location (1-based row/column)
  computed at import time from sheet
  structure and stored for export.
  Feature 003 overwrites the whole cell:
  SINGLE -> "answer"; every 題組 slot ->
  "（k）answer" (k = subPart), including
  an unmarked numbered row (subPart 1).
end note

note bottom of Submission
  arrivalSeq and receivedAt are assigned by
  the server inside one atomic transaction
  (BEGIN IMMEDIATE, UNIQUE(group_id, unit_id));
  at most one isWinner per QuestionUnit (I).
  Group, Participant and Submission are
  specified by later features.
end note

note left of QuestionUnit
  kind = GROUP_SET (題組) when it has
  2+ slots, otherwise SINGLE.
end note

package "Transient import types (not stored)" <<Rectangle>> {
  class SpreadsheetInfo {
    spreadsheetId : str
    title : str
    tabs : TabInfo[]
    requestedGid : int | None
    preselectedSheetId() : int
  }
  class TabInfo {
    sheetId : int
    title : str
    index : int
  }
  class TabData {
    spreadsheetId : str
    spreadsheetTitle : str
    sheetId : int
    title : str
    grid : str[][]
    merges : (r0, r1, c0, c1)[]
  }
  class ImportPreview {
    header : HeaderInfo | None
    units : ParsedUnit[]
    issues : Issue[]
    spreadsheetId, sheetId, tabTitle
    fingerprint : str
    canConfirm() : bool
  }
  class HeaderInfo {
    row : int
    numberColumn : int
    answerColumn : int
  }
  class ParsedUnit {
    number : int
    kind : UnitKind
    sourceRow : int
  }
  class ParsedSlot {
    subPart : int
    row : int
    column : int
    a1Ref : str
    existingText : str
  }
  class Issue {
    severity : error | warning
    code : str
    message : str
    cells : str[]
    rows : int[]
  }
}

SpreadsheetInfo *-- TabInfo
ImportPreview *-- HeaderInfo
ImportPreview *-- ParsedUnit
ImportPreview *-- Issue
ParsedUnit *-- ParsedSlot
@enduml
