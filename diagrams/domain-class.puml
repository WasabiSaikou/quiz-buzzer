@startuml domain-class
title Quiz Buzzer (課堂搶答系統) - Domain Classes

skinparam shadowing false
skinparam defaultFontName "Microsoft JhengHei"
hide empty methods

enum Phase {
  DRAFT
  OPEN
  CLOSED
}

enum UnitKind {
  SINGLE
  GROUP_SET
}

class Activity {
  id : Id
  title : String
  phase : Phase
  groupCount : Integer {2..12}
  sourceSpreadsheetId : String
  sourceTabTitle : String
  createdAt : DateTime
  importedAt : DateTime
}

class QuestionUnit {
  id : Id
  number : Integer {>0}
  kind : UnitKind
  sourceRow : Integer
  position : Integer
}

class AnswerSlot {
  id : Id
  subPart : Integer {>0}
  tabTitle : String
  cellRow : Integer
  cellColumn : Integer
  a1Ref : String
}

class Group {
  id : Id
  number : Integer {1..groupCount}
  name : String
}

class Participant {
  id : Id
  displayName : String
  joinedAt : DateTime
}

class Submission {
  id : Id
  arrivalSeq : Integer
  receivedAt : DateTime
  answers : Map<AnswerSlot, String>
  isWinner : Boolean
}

Activity "1" *-- "1..*" QuestionUnit : questions >
QuestionUnit "1" *-- "1..*" AnswerSlot : slots >
Activity "1" *-- "2..12" Group : groups >
Group "1" *-- "0..*" Participant : members >
QuestionUnit "1" o-- "0..*" Submission : submissions >
Group "1" -- "0..*" Submission : submits >
Activity --> Phase
QuestionUnit --> UnitKind

note right of AnswerSlot
  Cell location computed at import
  time from sheet structure and
  stored for later export.
  Feature 003 overwrites the whole cell:
  SINGLE -> "answer"; every 題組 slot ->
  "（k）answer" (k = subPart), including
  an unmarked numbered row (subPart 1).
end note

note bottom of Submission
  arrivalSeq and receivedAt are assigned by
  the server inside one atomic transaction;
  at most one isWinner per QuestionUnit (I).
  Group, Participant and Submission are
  specified by later features.
end note

note right of Activity
  At most one Activity is non-CLOSED
  (DRAFT or OPEN) at a time.
  CLOSED activities are kept, with
  results / CSV viewable.
end note

note left of QuestionUnit
  kind = GROUP_SET (題組) when it has
  2+ slots, otherwise SINGLE.
end note
@enduml
